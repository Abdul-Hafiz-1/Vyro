# ==============================================================================
# VYRO — Autonomous AI Commerce Network
# Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
ALLOW_SIMULATION=true

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# PayPal Developer Sandbox (Orders API v2)
# Create a Sandbox REST app at: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here

# Firebase Configuration (Firestore & Auth)
# Generate from Firebase Console -> Project Settings -> Service Accounts
FIREBASE_PROJECT_ID=vyro-network-sandbox
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@vyro-network-sandbox.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
