# ==============================================================================
# VYRO — Autonomous AI Marketplace
# Environment Configuration Template (copy to .env and fill your own keys)
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
ALLOW_SIMULATION=true

# Database Configuration (SQLite file path relative to server/)
SQLITE_DB_PATH=data/vyro.db

# Session Signing Secret (set a random 32+ character string before running)
SESSION_SECRET=your_random_session_secret_at_least_32_chars

# Decision Engine, Platform Fee & Lifecycle Windows
AUTO_APPROVE_LIMIT_DEFAULT=200
DAILY_BUDGET_CAP_DEFAULT=500
PLATFORM_FEE_PERCENT=5
REVIEW_WINDOW_HOURS=72
DISPUTE_RESPONSE_HOURS=72

# Google Gemini API (leave blank to use built-in deterministic parsing/negotiation fallback)
# Get a free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# PayPal Developer Sandbox (Orders API v2 & Payouts API v1)
# Create a Sandbox REST app at: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENV=sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
VITE_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here

# Optional: Platform merchant email (prevents sellers from using the platform merchant email as their payout target)
PAYPAL_MERCHANT_EMAIL=

# Payment & Payout Providers
# In production (NODE_ENV=production), mock/simulated providers and /api/v1/payments/mock-settle are disabled (404).
# Set PAYMENT_PROVIDER=mock only during local automated tests that invoke /api/v1/payments/mock-settle.
PAYMENT_PROVIDER=paypal
PAYPAL_PAYOUT_PROVIDER=paypal
