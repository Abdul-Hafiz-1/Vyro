# ==============================================================================
# VYRO — Autonomous AI Marketplace
# Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
ALLOW_SIMULATION=true

# Database Configuration (SQLite Single Source of Truth)
SQLITE_DB_PATH=data/vyro.db

# Decision Engine & Platform Fee Defaults
AUTO_APPROVE_LIMIT_DEFAULT=200
DAILY_BUDGET_CAP_DEFAULT=500
PLATFORM_FEE_PERCENT=5

# Google Gemini API (leave blank to use deterministic negotiation/parsing fallback)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# PayPal Developer Sandbox (Orders API v2 & Payouts API v1)
# Create a Sandbox REST app at: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENV=sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
VITE_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here

# Optional: Merchant email check (prevents sellers from entering platform merchant email as payout target)
PAYPAL_MERCHANT_EMAIL=

# Payment & Payout Providers
# In production (NODE_ENV=production), mock/simulated providers and /mock-settle are blocked.
# Set PAYMENT_PROVIDER=mock only during automated dev/test runs that execute /api/v1/payments/mock-settle.
PAYMENT_PROVIDER=paypal
PAYPAL_PAYOUT_PROVIDER=paypal
