# ==============================================================================
# VYRO — Autonomous AI Marketplace
# Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (Single Source of Truth)
SQLITE_DB_PATH=vyro.db

# Decision Engine Defaults
AUTO_APPROVE_LIMIT_DEFAULT=200
DAILY_BUDGET_CAP_DEFAULT=500

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# PayPal Developer Sandbox (Orders API v2)
# Create a Sandbox REST app at: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
